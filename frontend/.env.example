# ==========================================
# Trendies Frontend Environment Configuration
# ==========================================
# Copy this file to .env and replace placeholders with your actual credentials.
# Do NOT commit .env to source control.

# Firebase Client API Key (for Google Sign-In popup)
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderClientApiKeyHere

# Razorpay Checkout Client Key ID (Public key for checkout modal)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
