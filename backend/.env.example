# ==========================================
# Trendies Backend Environment Configuration
# ==========================================
# Copy this file to .env and replace placeholders with your actual credentials.
# Do NOT commit .env to source control.

# Server Port (Set to 3000 to match Vite dev proxy and Docker configs)
PORT=3000

# Environment Mode: 'development' or 'production'
# In production, cookies require HTTPS (Secure=true, SameSite=None)
NODE_ENV=development

# Database Connection URI (MongoDB Atlas or local container)
# For local Docker: mongodb://mongo:27017/trendies
# For local machine: mongodb://127.0.0.1:27017/trendies
MONGODB_URI=mongodb://127.0.0.1:27017/trendies

# Authentication Secret (Used for JWT cookie signing/verifying)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Admin Static Credentials (Used for admin portal login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

# Cloudinary Storage (Used for product image uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# AI Shopping Assistant (OpenRouter API)
OPENROUTER_API_KEY=sk-or-v1-placeholder_openrouter_api_key

# Google OAuth via Firebase Admin SDK
FIREBASE_PROJECT_ID=placeholder_firebase_project_id
FIREBASE_CLIENT_EMAIL=placeholder_service_account@placeholder.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
